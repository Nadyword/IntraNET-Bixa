{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WebApiDatabase": "Server=(localdb)\\mssqllocaldb;Database=Bixa;Trusted_Connection=True;",
    "DbProxi": "Server=(localdb)\\mssqllocaldb;Database=DEMON;Trusted_Connection=True;"
  },
  "ConfiguracionJwt": {
    "Llave": "3306af6562d891554da7d6cbf232eb00213ff3a38c25e",
    "Issuer": "Software en Facil",
    "Audience": "All",
    "ExpirationMinutes": 60
  },
  "AllowedOrigins": [
    "www.eicconstruccion.com"
  ],
  "AllowedIPs": [
    "172.28.0.9",
    "172.28.0.10"
  ],
  "ShowInformationLog": true,
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{ApplicationName}][{EnvironmentName}][{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10485760,
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ]
  },
  "WebhookSettings": {
    "NotificationUrls": [
      "http://localhost:5001/api/webhooks/receive",
      "https://your-production-client.com/api/notifications"
    ]
  }
}