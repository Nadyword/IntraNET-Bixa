<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bixa.Backend.Services</RootNamespace>
    <!-- Requerido por NPOI (lectura/escritura de la plantilla .xls de la planilla AR-I). -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Mapper\TypeConverters\**" />
    <EmbeddedResource Remove="Mapper\TypeConverters\**" />
    <None Remove="Mapper\TypeConverters\**" />
  </ItemGroup>

 <ItemGroup>
   <PackageReference Include="ClosedXML" Version="0.105.1" />
   <PackageReference Include="MailKit" Version="4.17.0" />
   <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
   <PackageReference Include="AutoMapper" Version="16.2.0" />
   <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
   <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
   <PackageReference Include="NPOI" Version="2.8.0" />
   <PackageReference Include="QuestPDF" Version="2026.8.0" />
   <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
 </ItemGroup>
   

 <ItemGroup>
    <ProjectReference Include="..\Bixa.Backend.Models\Bixa.Backend.Models.csproj" />    
    <ProjectReference Include="..\Bixa.Backend.DataAccess\Bixa.Backend.DataAccess.csproj" />
  </ItemGroup>

</Project>
